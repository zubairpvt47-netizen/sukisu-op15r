# Pinned sources (sourced by build-op15r.yml).

# SukiSU Nova (formerly SukiSU Ultra; renamed 2026-11-16), branch `builtin-new`: the rewritten in-tree
# ("built-in") line that the Nova docs describe (KSU_LSM_SECURITY_HOOKS, SUSFS inline hooks, KPM, ...).
# UAPI 6; manager package com.sukisu.nova. `builtin` (old line) and `main` (no SUSFS) are NOT used.
# Pin = builtin-new tip of 2026-11-16 ("bump Version Number").
NOVA_REPO=https://github.com/SukiSU-Nova/SukiSU-Nova.git
NOVA_BRANCH=builtin-new
NOVA_PIN=5a3ec4145059ed2c4f22c70a16a28a616e104c33

# SUSFS (susfs4ksu gki-android16-6.12), v2.4.0. Only its KERNEL side is used (50_add_susfs patch + fs/ and
# include/ files). Nova builtin-new already carries the KernelSU-side SUSFS glue, so
# KernelSU/10_enable_susfs_for_ksu.patch must NOT be applied. All 12 ksu_* hooks that the 50_ patch
# calls exist in Nova at the pin above (checked 2026-11-16).
SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=gki-android16-6.12
SUSFS_PIN=9b0b13f069673b9b07b713a5c66977de4d62b175

# WildKernels SUSFS helper scripts (context restore, <6.12.92 compat, fanotify arity, ...).
WK_REPO=https://github.com/WildKernels/GKI_KernelSU_SUSFS.git
WK_PIN=243bb5a9e72af82251605f1c5c51dab9146a2efd
