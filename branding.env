# SUKISU branding + manager<->kernel contract. Sourced by .github/workflows/build.yml.
# Public values only: the signing key itself lives in repository secrets and in an offline backup.

APP_NAME="SUKISU"
# Android applicationId of the manager. The kernel only crowns a manager whose package name AND
# signing certificate match the two values below, so all three change together or not at all.
# (Internal Kotlin/JNI class names keep the upstream `com.sukisu.nova` namespace: applicationId may differ
# from the namespace, which is exactly what Nova's own PR builds do with `com.sukisu.nova.pr`.)
PACKAGE_NAME="com.op15r.sukisu"

# Signing certificate of the manager (DER length, as hex, and its SHA-256), derived from our own key.
# CERT_SIZE/CERT_SHA256 = what `ksud debug get-sign` prints and what Nova's kernel compares.
CERT_SIZE="0x0337"
CERT_SHA256="aa22ef0fd5689fcd7a5567fde5aa7fc408f88f1521728a2e99719a2d7ac8ae18"

# Manager / ksud / BuiltZygisk source: SukiSU Nova `main` (UAPI 6), fetched at build time with full
# history (versionCode and ksud version are derived from the commit count).
NOVA_REPO="https://github.com/SukiSU-Nova/SukiSU-Nova.git"
NOVA_MANAGER_PIN="c60f21b9e00e35e898f8d21e0612465b76b9beec"
# The kernel-side driver (`builtin-new`) is pinned in android16-6.12/root-pins.env.

# KPM tools bundled in the APK (kptools runs as root on the phone). Nova's gradle task downloads them from a moving
# branch (the old ShirkNeko URL now 404s); we pin the commit and verify the hashes before building.
KPM_PATCH_REPO="SukiSU-Nova/SukiSU_patch"
KPM_PATCH_PIN="4ee085a39e3c95e44c9cac7af040e83bf926e6fa"
KPTOOLS_SHA256="3129cafd6fd0d9fdd6375b1b760c215cd11f94b3ce6eb13dc437a04d24d99244"
KPIMG_SHA256="14fc6564fa092afe4a2293268cd061da64a20f61dc91396a404daf13d053f5ca"
